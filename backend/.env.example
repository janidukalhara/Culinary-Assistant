# world: open-vocabulary YOLO-World, best for a quick fridge demo
# standard: YOLOv8n COCO model (limited food classes)
# custom: your own trained YOLOv8 weights
YOLO_MODE=world

# Leave empty to use the mode default.
# world default: yolov8s-worldv2.pt
# standard default: yolov8n.pt
# custom default: backend/models/best.pt
# YOLO_MODEL_PATH=

YOLO_CONFIDENCE=0.25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
